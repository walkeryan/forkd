# Copy to .env.local-test (gitignored) for the local Docker test stack:
#   docker compose -p forkd-local -f docker-compose.prod.yml -f docker-compose.local-test.yml --env-file .env.local-test up --build -d
#
# Dummy values are fine — the goal is booting the app, not signing in.
# POSTGRES_PASSWORD just needs to match between forkd and forkd-db.
# NEXTAUTH_SECRET must be valid base64.
# Note: use neutral placeholders here; values shaped like real Google
# credentials trip GitHub push protection even when fake.

POSTGRES_PASSWORD=localtest123
NEXTAUTH_SECRET=dGVzdC1zZWNyZXQtZm9yLWxvY2FsLXRlc3Rpbmctb25seQ==
AUTH_GOOGLE_ID=dummy-client-id
AUTH_GOOGLE_SECRET=dummy-client-secret
GOOGLE_PLACES_API_KEY=dummy-places-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=dummy-maps-key
