# Fork'd production environment — copy to `.env.prod` on the Unraid server and fill in.
# docker-compose.prod.yml reads these values.

# Postgres password used by both the app's DATABASE_URL and the postgres container.
# Use the value from POSTGRES_PASSWORD.txt (generated when secrets were set).
POSTGRES_PASSWORD=changeme-strong-password

# NextAuth
NEXTAUTH_SECRET=changeme-base64-secret
AUTH_GOOGLE_ID=832068257830-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Google APIs (server-side Places + browser-side Maps JS). Same GCP key.
GOOGLE_PLACES_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxx
