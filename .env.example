DATABASE_URL="postgresql://forkd:password@localhost:5432/forkd"
# Base URL NextAuth uses for callback/redirect URLs. Use http://localhost:3333
# for purely local dev. To reach the dev server from other devices on your LAN
# (e.g. testing on a phone), set this to this machine's local IP, like
# http://192.168.1.226:3333 — otherwise auth redirects bounce back to localhost.
NEXTAUTH_URL="http://localhost:3333"
NEXTAUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_APP_URL="http://localhost:3333"

# Server-side key for the Google Places API (Text Search + Nearby Search).
# Without this, the "Add a Place" search/nearby lookup will fail.
# Get one at https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_PLACES_API_KEY=""

# Browser-exposed key for the Maps JavaScript API (the /map page). The same
# Google Cloud key works — just make sure the "Maps JavaScript API" is enabled
# on the project in addition to the Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
