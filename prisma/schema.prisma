generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  userPlaces    UserPlace[]
  wishlist      WishlistItem[]
  tags          Tag[]
  photos        Photo[]
  sharedLists   SharedList[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Place {
  id            String   @id @default(cuid())
  name          String
  address       String?
  city          String?
  state         String?
  lat           Float?
  lng           Float?
  googlePlaceId String?  @unique
  cuisine       String?
  phone         String?
  website       String?
  imagePath     String?  // cached Google Places photo, relative to UPLOAD_DIR
  createdAt     DateTime @default(now())
  userPlaces    UserPlace[]
  wishlist      WishlistItem[]
  specials      PlaceSpecial[]
  @@index([googlePlaceId])
}

model PlaceSpecial {
  id          String   @id @default(cuid())
  placeId     String
  place       Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  type        String   // "happy_hour" | "weekly_special" | "trivia" | "live_music" | "brunch" | "other"
  title       String
  description String?
  dayOfWeek   Int?     // 0=Sun, 1=Mon ... 6=Sat, null=daily/varies
  startTime   String?  // "17:00"
  endTime     String?  // "19:00"
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([placeId])
}

model UserPlace {
  id          String    @id @default(cuid())
  userId      String
  placeId     String
  rating      Float?
  priceRange  Int?
  notes       String?   @db.Text
  status      String    @default("visited")
  visitCount  Int       @default(0)
  lastVisited DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  place       Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  visits      Visit[]
  meals       Meal[]
  photos      Photo[]
  tags        UserPlaceTag[]
  @@unique([userId, placeId])
  @@index([userId])
  @@index([rating])
}

model Visit {
  id          String   @id @default(cuid())
  userPlaceId String
  visitedAt   DateTime @default(now())
  notes       String?  @db.Text
  rating      Float?
  photos      Photo[]
  userPlace   UserPlace @relation(fields: [userPlaceId], references: [id], onDelete: Cascade)
  @@index([userPlaceId])
}

model Meal {
  id              String  @id @default(cuid())
  userPlaceId     String
  createdAt       DateTime @default(now())
  name            String
  description     String? @db.Text
  rating          Float?
  serviceRating   Int?
  isFavorite      Boolean @default(false)
  notes           String? @db.Text
  serviceNotes    String? @db.Text
  managementNotes String? @db.Text
  photos          Photo[]
  userPlace       UserPlace @relation(fields: [userPlaceId], references: [id], onDelete: Cascade)
  @@index([userPlaceId])
}

model Photo {
  id          String   @id @default(cuid())
  userId      String
  path        String
  caption     String?
  createdAt   DateTime @default(now())
  userPlaceId String?
  visitId     String?
  mealId      String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlace   UserPlace? @relation(fields: [userPlaceId], references: [id], onDelete: SetNull)
  visit       Visit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)
  meal        Meal?      @relation(fields: [mealId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([userPlaceId])
}

model Tag {
  id         String         @id @default(cuid())
  name       String
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlaces UserPlaceTag[]
  @@unique([name, userId])
  @@index([userId])
}

model UserPlaceTag {
  userPlaceId String
  tagId       String
  userPlace   UserPlace @relation(fields: [userPlaceId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([userPlaceId, tagId])
}

model WishlistItem {
  id      String   @id @default(cuid())
  userId  String
  placeId String
  notes   String?
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place   Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  @@unique([userId, placeId])
}

model SharedList {
  id        String   @id @default(cuid())
  userId    String
  slug      String   @unique @default(cuid())
  title     String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([slug])
}
